{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "copy-cesium": "node scripts/copy-cesium.mjs",
    "copy-data": "node scripts/copy-data.mjs",
    "predev": "npm run copy-cesium && npm run copy-data && node scripts/fetch-tiles.mjs --soft",
    "prebuild": "npm run copy-cesium && npm run copy-data && node scripts/fetch-tiles.mjs --soft",
    "fetch-tiles": "node scripts/fetch-tiles.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "cesium": "^1.146.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
